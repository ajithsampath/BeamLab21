# Python project .gitignore

# Large / downloaded data files
*.h5
*.hdf5
data/*.npz
data/*.npy
data/*.txt

# Generated results
outputs/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# VS Code settings
.vscode/

# Python virtual environments
venv/
env/
.venv/

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# Build / distribution folders
build/
dist/
*.egg-info/

# Test / lint / coverage caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS-specific files
.DS_Store
Thumbs.db

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Secrets / local config
*.env

# Local-only scratch notebook for developing drone-fit against real (private)
# flight-track data, before the working version is merged into
# beamlab21.drone.fit_data
tests/drone_fit_dev.ipynb

# Local tutorial notebook (not distributed — run locally to verify functionality)
tutorial.ipynb

# Example notebooks and scripts (kept local; README covers the same material)
examples/
