# Python project .gitignore

# Large / downloaded data files
*.h5
*.hdf5
data/*.npz
data/*.npy

# Generated results
outputs/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# VS Code settings
.vscode/

# Python virtual environments
venv/
env/
.venv/

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# Build / distribution folders
build/
dist/
*.egg-info/

# Test / lint / coverage caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS-specific files
.DS_Store
Thumbs.db

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Secrets / local config
*.env

# Local-only: one line, the Example_cube.npz download URL
data/DATA_URL.txt
